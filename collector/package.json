{
  "name": "soc-collector",
  "version": "0.4.0",
  "private": true,
  "description": "Coletor Microsoft Graph Security -> PostgreSQL do projeto SOC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
