    "start": "node dist/index.js"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
