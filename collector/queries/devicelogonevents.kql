// Autenticações nos dispositivos (Frente 1 e Frente 4).
// {{start}} e {{end}} são preenchidos pelo coletor em UTC; o fim é exclusivo.
// Filtro do piloto: servidores (nomes com "srv" ou "fisico").
DeviceLogonEvents
| where Timestamp >= datetime({{start}}) and Timestamp < datetime({{end}})
| where (DeviceName contains "srv" or DeviceName contains "fisico")
    and DeviceName !contains "note" and DeviceName !contains "micro"
