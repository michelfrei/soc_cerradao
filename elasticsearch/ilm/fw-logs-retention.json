{
  "policy": {
    "_meta": {
      "description": "Logs brutos do FortiGate: rollover diário ou 30 GB; apagados 10 dias após o rollover (30 dias quando o disco da VM-Docker for ampliado)."
    },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "30gb"
          }
        }
      },
      "delete": {
        "min_age": "10d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
