            "changed": {
              "type": "long"
            },
            "api_calls": {
              "type": "long"
            },
            "throttled": {
              "type": "long"
            },
            "database_bytes": {
              "type": "long"
            },
            "raw_bytes": {
              "type": "long"
            },
            "publication_bytes": {
              "type": "long"
            },
            "history_bytes": {
              "type": "long"
            },
            "elastic_heap_used_bytes": {
              "type": "long"
            },
            "elastic_heap_max_bytes": {
              "type": "long"
            },
            "elastic_fs_total_bytes": {
              "type": "long"
            },
            "elastic_fs_available_bytes": {
              "type": "long"
            },
            "elastic_store_bytes": {
              "type": "long"
            }
          }
        }
      }
