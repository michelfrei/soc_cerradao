              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "confidence": {
              "type": "keyword"
            },
            "has_sid": {
              "type": "boolean"
            },
            "classification_source": {
              "type": "keyword"
            },
            "is_local_admin": {
              "type": "boolean"
            },
            "privileged": {
              "type": "boolean"
            },
            "owner": {
              "type": "keyword"
            }
          }
        },
        "asset": {
          "properties": {
            "expected": {
              "type": "boolean"
            },
            "observed": {
              "type": "boolean"
            },
            "owner": {
              "type": "keyword"
            },
            "environment": {
              "type": "keyword"
            },
            "criticality": {
              "type": "keyword"
            },
            "onboarding_status": {
              "type": "keyword"
            },
            "sensor_health": {
              "type": "keyword"
            },
            "device_type": {
              "type": "keyword"
            },
            "machine_group": {
              "type": "keyword"
            },
            "os_platform": {
              "type": "keyword"
            },
            "last_seen": {
              "type": "date"
            },
            "snapshot_at": {
              "type": "date"
            }
          }
        },
        "metrics": {
