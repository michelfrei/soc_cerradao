                  "ignore_above": 1024
                }
              }
            },
            "status": {
              "type": "keyword"
            },
            "severity": {
              "type": "keyword"
            },
            "classification": {
              "type": "keyword"
            },
            "determination": {
              "type": "keyword"
            },
            "assigned_to": {
              "type": "keyword"
            },
            "service_source": {
              "type": "keyword"
            },
            "incident_id": {
              "type": "keyword"
            },
