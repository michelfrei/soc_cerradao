{
  "dynamic": false,
  "properties": {
    "@timestamp": {
      "type": "date"
    },
    "tags": {
      "type": "keyword"
    },
    "event": {
      "properties": {
        "kind": {
          "type": "keyword"
        },
        "module": {
          "type": "keyword"
        },
        "dataset": {
          "type": "keyword"
        },
        "action": {
          "type": "keyword"
        },
        "outcome": {
          "type": "keyword"
        },
        "reason": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "severity_name": {
          "type": "keyword"
        },
        "ingested": {
          "type": "date"
        },
        "category": {
          "type": "keyword"
        },
        "type": {
          "type": "keyword"
        }
      }
    },
    "host": {
      "properties": {
        "name": {
          "type": "keyword"
        },
        "id": {
          "type": "keyword"
        }
      }
    },
    "user": {
      "properties": {
        "name": {
          "type": "keyword"
        },
        "domain": {
          "type": "keyword"
        },
        "id": {
          "type": "keyword"
        }
      }
    },
    "source": {
      "properties": {
        "ip": {
          "type": "ip",
          "ignore_malformed": true
        },
        "domain": {
          "type": "keyword"
        },
        "port": {
          "type": "long",
          "ignore_malformed": true
        }
      }
    },
    "destination": {
      "properties": {
        "ip": {
          "type": "ip",
          "ignore_malformed": true
        },
        "domain": {
          "type": "keyword"
        },
        "port": {
          "type": "long",
          "ignore_malformed": true
        }
      }
    },
    "process": {
      "properties": {
        "name": {
          "type": "keyword"
        },
        "pid": {
          "type": "long",
          "ignore_malformed": true
        },
        "command_line": {
          "type": "wildcard"
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "parent": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    },
    "file": {
      "properties": {
        "name": {
          "type": "keyword"
        },
        "path": {
          "type": "keyword",
          "ignore_above": 4096
        },
        "hash": {
          "properties": {
            "sha256": {
              "type": "keyword"
            }
          }
        }
      }
    },
    "winlog": {
      "properties": {
        "logon": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            }
          }
        }
      }
    },
