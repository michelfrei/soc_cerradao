              "type": "keyword"
            },
            "status": {
              "type": "keyword"
            },
            "finished_at": {
              "type": "date"
            },
            "started_at": {
              "type": "date"
            },
            "watermark": {
              "type": "date"
            },
            "window_start": {
              "type": "date"
            },
            "window_end": {
              "type": "date"
            },
            "lag_seconds": {
              "type": "double"
            },
            "duration_ms": {
              "type": "double"
