{
  "description": "Administrador funcional SOC: dashboards, consultas, regras, alertas e Cases no espaco SOC. Sem superuser ou gestao de usuarios/cluster.",
  "elasticsearch": {
    "cluster": ["monitor", "manage_own_api_key"],
    "indices": [
      { "names": ["soc-*"], "privileges": ["read", "view_index_metadata"] },
      { "names": [".alerts-security.alerts-soc", ".internal.alerts-security.alerts-soc-*", ".lists-soc", ".items-soc"], "privileges": ["manage", "write", "read", "view_index_metadata", "maintenance"] },
      { "names": [".preview.alerts-security.alerts-soc", ".internal.preview.alerts-security.alerts-soc-*"], "privileges": ["read", "view_index_metadata"] }
    ]
  },
  "kibana": [{ "base": [], "spaces": ["soc"], "feature": {
    "dashboard_v2": ["all"], "discover_v2": ["all"], "visualize_v2": ["all"],
    "siemV5": ["all"], "securitySolutionRulesV4": ["all"],
    "securitySolutionAlertsV1": ["all"], "securitySolutionCasesV3": ["all"],
    "indexPatterns": ["all"], "advancedSettings": ["all"], "savedObjectsManagement": ["all"],
    "savedQueryManagement": ["all"]
  } }]
}
