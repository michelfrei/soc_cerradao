# Copie para .env (cp .env.example .env && chmod 600 .env) e preencha.
# O .env contém senhas: não versione, não envie por chat ou e-mail.
# Gere senhas com:  openssl rand -hex 24
# Gere chaves do Kibana com:  openssl rand -hex 32

# --- Versões -------------------------------------------------------------------
# Versão exata da Elastic Stack (Elasticsearch, Kibana e Logstash iguais).
STACK_VERSION=9.5.5
COLLECTOR_VERSION=0.5.0
SYSLOG_RELAY_VERSION=1.0.0

# --- Endereços -------------------------------------------------------------------
# IP/DNS desta VM: entram no certificado do Kibana/Elasticsearch.
SOC_PUBLIC_IP=
SOC_PUBLIC_DNS=
# IP desta VM que o FortiAnalyzer usa para enviar os logs (certificado do syslog-relay).
# Vazio: usa SOC_PUBLIC_IP.
SOC_SYSLOG_IP=
# URL que os analistas usarão para abrir o Kibana.
KIBANA_PUBLIC_URL=https://IP_DA_VM_DOCKER:5601

# --- PostgreSQL (VM separada) ------------------------------------------------------
SOC_PG_HOST=
SOC_PG_PORT=5432
SOC_PG_SSLMODE=require
# Após emitir certificado com SAN correspondente a SOC_PG_HOST e copiar SOMENTE
# a CA pública para docker/certs/postgres/ca.crt, ative SOC_PG_SSLMODE=verify-full.
# O Compose monta essa pasta nos dois consumidores. Não copie chaves privadas.
# Conteúdo de /root/soc-secrets/pg_logstash_password na VM do PostgreSQL.
SOC_LOGSTASH_DB_PASSWORD=

# --- Elasticsearch / Kibana -------------------------------------------------------
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
SOC_ES_LOGSTASH_USER=soc_logstash
SOC_ES_LOGSTASH_PASSWORD=
KIBANA_ENCRYPTION_KEY=
KIBANA_SECURITY_KEY=
KIBANA_REPORTING_KEY=
# Leitura de fw-logs-* pelo coletor (agregados da firewall). Gere com openssl rand -hex 24
# e grave a MESMA senha em docker/secrets/es_collector_password.
SOC_ES_COLLECTOR_USER=soc_collector_es
SOC_ES_COLLECTOR_PASSWORD=
# basic (gratuita) ou trial (30 dias com recursos pagos).
ES_LICENSE=basic

# --- Microsoft Graph -----------------------------------------------------------------
# O client secret NÃO vai aqui: fica em docker/secrets/graph_client_secret.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_MAX_CONCURRENCY=2
COLLECTOR_LOG_LEVEL=info
# Proxy de saída, se a rede exigir:
# HTTPS_PROXY=http://proxy.dominio.local:3128
# NO_PROXY=localhost,127.0.0.1,es01
# NODE_USE_ENV_PROXY=1

# --- Recursos (VM de ~16 GB de RAM) ---------------------------------------------------
ES_HEAP=4g
ES_MEM_LIMIT=8g
LS_HEAP=1g
LS_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=2g
COLLECTOR_MEM_LIMIT=512m
SYSLOG_RELAY_MEM_LIMIT=256m

# --- Armazenamento no host -------------------------------------------------------------
# Confirme que estes caminhos estão no disco planejado (findmnt -T <caminho>).
ES_DATA_DIR=/srv/soc/esdata
ES_SNAPSHOT_DIR=/srv/soc/es-snapshots
LS_DATA_DIR=/srv/soc/logstash-data

# --- Exposição de portas -----------------------------------------------------------------
ES_BIND=127.0.0.1
KIBANA_BIND=0.0.0.0

# --- Logs da firewall (FortiAnalyzer → syslog-relay:6514) -------------------------------
# IPs de origem aceitos (o FortiAnalyzer), separados por vírgula. Vazio: recusa tudo.
FW_SYSLOG_ALLOWED=
FW_SYSLOG_BIND=0.0.0.0
